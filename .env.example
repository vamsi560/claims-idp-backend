# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fnol_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your_connection_string
AZURE_STORAGE_CONTAINER=fnol-attachments

# Gemini LLM
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Azure Document Intelligence
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your_doc_intelligence_key

# TPA (Third Party Administrator) Integration
TPA_API_URL=https://api.your-tpa-provider.com
TPA_API_KEY=your_tpa_api_key
TPA_WEBHOOK_SECRET=your_shared_webhook_secret
